{
  "name": "dsh-window",
  "version": "0.1.0",
  "description": "DeepSeek Harness 窗口 GUI 客户端：基于 Tauri，自动拉起 dsh web 并在应用窗口中打开",
  "license": "MIT",
  "author": "dsh-window contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/he110Warudo/dsh-window.git"
  },
  "homepage": "https://github.com/he110Warudo/dsh-window",
  "bugs": {
    "url": "https://github.com/he110Warudo/dsh-window/issues"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "window",
    "tauri",
    "gui",
    "dsh-plugin"
  ],
  "scripts": {
    "start": "tauri dev",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "smoke": "node test/smoke-launch.js",
    "prepare:sidecar": "node scripts/prepare-node-sidecar.js",
    "dist": "npm run prepare:sidecar && tauri build",
    "dist:dir": "npm run prepare:sidecar && tauri build --no-bundle"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.1.0-rc.6": true,
    "koffi@3.1.5": true,
    "node-pty@1.1.0": true
  }
}
