{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Window",
  "version": "0.1.0",
  "identifier": "ai.deepseek.dshwindow",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "DSH Window",
        "url": "index.html",
        "width": 560,
        "height": 430,
        "resizable": false,
        "center": true,
        "visible": false,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "bin/node.exe": "bin/node.exe",
      "../node_modules": "node_modules"
    },
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    }
  }
}

